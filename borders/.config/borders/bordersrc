#!/usr/bin/env bash
# JankyBorders config — pencere etrafına focus border çizer.
# Docs: https://github.com/FelixKratz/JankyBorders

options=(
    style=round                       # round | square
    width=6.0                         # border kalınlığı (px)
    hidpi=on                          # retina ekran için
    active_color=0xffcba6f7           # focused: Catppuccin Mocha mauve (Ghostty teması ile uyumlu)
    inactive_color=0xff45475a         # unfocused: surface1 — soluk
    background_color=0x00000000       # transparent
    blacklist="Spotify,zoom.us"       # bu app'lerde border çizme
)

borders "${options[@]}"
