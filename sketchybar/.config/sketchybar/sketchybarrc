#!/usr/bin/env bash
# SketchyBar — custom macOS menubar
# Docs: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ============================================================
# Bar geometrisi
# ============================================================
sketchybar --bar height=32                            \
                 blur_radius=30                       \
                 position=top                         \
                 sticky=on                            \
                 padding_left=10                      \
                 padding_right=10                     \
                 color=0xaa1e1e2e                     \
                 border_width=0                       \
                 corner_radius=0                      \
                 y_offset=0                           \
                 margin=0

# ============================================================
# Default item ayarları (her item bunları miras alır)
# ============================================================
sketchybar --default updates=when_shown                       \
                    icon.font="Hack Nerd Font:Bold:14.0"      \
                    icon.color=0xffcdd6f4                     \
                    label.font="Hack Nerd Font:Bold:13.0"     \
                    label.color=0xffcdd6f4                    \
                    padding_left=5                            \
                    padding_right=5                           \
                    label.padding_left=4                      \
                    label.padding_right=4                     \
                    icon.padding_left=4                       \
                    icon.padding_right=4

# ============================================================
# Custom event: Aerospace workspace değişimini sketchybar'a duyur
# (Aerospace bunu --trigger ile ateşler — register edilmemişse no-op'tur)
# ============================================================
sketchybar --add event aerospace_workspace_change

# ============================================================
# SOL: AeroSpace workspace göstergesi
# ============================================================
SPACE_ICONS=("1" "2" "3" "4")
for i in "${!SPACE_ICONS[@]}"; do
    sid=$(($i+1))
    sketchybar --add item space.$sid left                                    \
               --subscribe space.$sid aerospace_workspace_change              \
               --set space.$sid icon="${SPACE_ICONS[$i]}"                     \
                                background.color=0x44585b70                   \
                                background.corner_radius=5                    \
                                background.height=22                          \
                                background.drawing=off                        \
                                label.drawing=off                             \
                                click_script="aerospace workspace $sid"       \
                                script="$PLUGIN_DIR/aerospace.sh $sid"
done

# ============================================================
# SOL: Aktif uygulama (workspace numaralarının yanında)
# ============================================================
sketchybar --add item front_app left                              \
           --set front_app icon.drawing=off                        \
                          label.padding_left=12                    \
                          script="$PLUGIN_DIR/front_app.sh"        \
           --subscribe front_app front_app_switched

# ============================================================
# ORTA: Şarkı (Spotify/Music çalıyorsa)
# ============================================================
sketchybar --add item media center                                \
           --set media script="$PLUGIN_DIR/media.sh"               \
                      update_freq=5                                \
                      label.max_chars=40                           \
                      scroll_texts=on                              \
           --subscribe media media_change

# ============================================================
# SAĞ TARAF — Catppuccin renk paletinde widget'lar + ayraçlar
# Her widget'in icon rengi farklı, label rengi standart text
# ============================================================

# Catppuccin Mocha renkleri:
# mauve=cba6f7  blue=89b4fa  green=a6e3a1  yellow=f9e2af  peach=fab387
# red=f38ba8  pink=f5c2e7  teal=94e2d5  surface1=45475a  text=cdd6f4

# Sağdan sola sırayla — her widget arası eşit padding (ayraç YOK, tek tip aralık)

sketchybar --add item clock right                                 \
           --set clock update_freq=10                              \
                       icon.drawing=off                            \
                       script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right                               \
           --set battery update_freq=120                           \
                         icon.color=0xffa6e3a1                     \
                         script="$PLUGIN_DIR/battery.sh"           \
           --subscribe battery system_woke power_source_change

sketchybar --add item wifi right                                  \
           --set wifi update_freq=30                               \
                      icon.color=0xff89b4fa                        \
                      script="$PLUGIN_DIR/wifi.sh"                 \
           --subscribe wifi wifi_change

sketchybar --add item volume right                                \
           --set volume icon.color=0xfff9e2af                      \
                        script="$PLUGIN_DIR/volume.sh"             \
           --subscribe volume volume_change

sketchybar --add item bluetooth right                             \
           --set bluetooth update_freq=60                          \
                           icon.color=0xff89b4fa                   \
                           script="$PLUGIN_DIR/bluetooth.sh"

sketchybar --add item weather right                               \
           --set weather update_freq=1800                          \
                         icon.color=0xfffab387                     \
                         script="$PLUGIN_DIR/weather.sh"

sketchybar --add item darkmode right                              \
           --set darkmode update_freq=60                           \
                          icon.color=0xfff9e2af                    \
                          script="$PLUGIN_DIR/darkmode.sh"

# ============================================================
# Finalize — başlangıçta aktif workspace'i hemen highlight et
# ============================================================
sketchybar --update

# Aerospace'ten anlık focused workspace'i al ve event'i tetikle
INIT_FOCUSED=$(aerospace list-workspaces --focused 2>/dev/null)
if [ -n "$INIT_FOCUSED" ]; then
    sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$INIT_FOCUSED"
fi

echo "✅ sketchybar yüklendi"
